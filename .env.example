# Naver Search API
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Google Custom Search API
GOOGLE_API_KEY=your_google_api_key
SEARCH_ENGINE_ID=your_google_search_engine_id

# Z.ai (GLM) OpenAI 호환 API
OPENAI_API_KEY=your_zai_api_key
OPENAI_BASE_URL=https://api.z.ai/api/paas/v4/
OPENAI_MODEL_BASIC=glm-5.3-flash
OPENAI_MODEL_ADVANCED=glm-4.6

# Gmail SMTP
GMAIL_USER=your_account@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Recipients (comma separated)
REPORT_RECIPIENTS=first@example.com

SAFETY_ALERT_RECIPIENTS=
ENABLE_0404_ALERTS=true
DEBUG_MODE=false
DRY_RUN=false
TIME_WINDOW_HOURS=24
MAX_ARTICLES_PER_CATEGORY=10
EMAIL_TOP_N=3
EMAIL_SUMMARY_MAX_CHARS=140
CRON_SECRET=replace_with_strong_secret

# Upstash Redis (실행 간 중복 제거·커뮤니티 VoC 다이제스트 조회용 - Vercel 대시보드 Marketplace > Upstash 연동 후 자동 주입)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# roaming_dashboard Supabase DB (통신 3사 공지사항 조회용, read-only)
# Supabase 대시보드 상단 Connect → Connection string → Transaction pooler(포트 6543)
DATABASE_URL=
